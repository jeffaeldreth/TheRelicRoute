<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox managed="false" spacing="8.0" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="libraryCatalog.ArtController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label text="Search by:" />
            <ComboBox fx:id="searchFieldCombo" prefWidth="150.0" />
            <TextField fx:id="searchTextField" onAction="#searchArt" prefWidth="200.0" promptText="Search term" />
            <Button onAction="#searchArt" text="Search" />
            <Button onAction="#showAllArt" text="Show All" />
            <Button fx:id="searchWebButton" managed="false" onAction="#searchWeb" text="Not found - Search the Web" visible="false" />
         </children>
      </HBox>
      <TableView fx:id="artTableView" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="titleColumn" prefWidth="130.0" text="Title" />
            <TableColumn fx:id="artistColumn" prefWidth="110.0" text="Artist" />
            <TableColumn fx:id="mediumColumn" prefWidth="90.0" text="Medium" />
            <TableColumn fx:id="genreColumn" prefWidth="90.0" text="Genre" />
            <TableColumn fx:id="yearColumn" prefWidth="50.0" text="Year" />
            <TableColumn fx:id="dimensionsColumn" prefWidth="85.0" text="Dimensions" />
            <TableColumn fx:id="framedColumn" prefWidth="60.0" text="Framed" />
            <TableColumn fx:id="signedColumn" prefWidth="60.0" text="Signed" />
            <TableColumn fx:id="onHandColumn" prefWidth="60.0" text="On Hand" />
            <TableColumn fx:id="purchasedColumn" prefWidth="110.0" text="Purchased From" />
            <TableColumn fx:id="locationColumn" prefWidth="80.0" text="Location" />
            <TableColumn fx:id="conditionColumn" prefWidth="75.0" text="Condition" />
            <TableColumn fx:id="valueColumn" prefWidth="55.0" text="Value" />
         </columns>
      </TableView>
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="titleField" promptText="Title" />
            <TextField fx:id="artistField" promptText="Artist" />
            <TextField fx:id="mediumField" promptText="Medium" />
            <TextField fx:id="genreField" promptText="Genre" />
         </children>
      </HBox>
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="yearField" prefWidth="70.0" promptText="Year" />
            <TextField fx:id="dimensionsField" prefWidth="140.0" promptText="Dimensions" />
            <TextField fx:id="onHandField" prefWidth="70.0" promptText="On Hand" />
            <TextField fx:id="purchasedField" prefWidth="220.0" promptText="Purchased From" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <TextField fx:id="locationField" promptText="Location" />
            <TextField fx:id="conditionField" promptText="Condition" />
            <TextField fx:id="valueField" prefWidth="70.0" promptText="Value" />
            <CheckBox fx:id="framedCheck" text="Framed" />
            <CheckBox fx:id="signedCheck" text="Signed" />
         </children>
      </HBox>
      <HBox spacing="8.0">
         <children>
            <Button onAction="#addArt" text="Add Art" />
            <Button onAction="#deleteArt" text="Delete Selected" />
         </children>
      </HBox>
   </children>
</VBox>
