<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="myAnchorPane" minHeight="300.0" minWidth="400.0" prefHeight="400.0" prefWidth="600.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="webView.Controller">
    <children>
        <TextField fx:id="urlTextField" layoutY="14.0" onAction="#loadPage" prefHeight="26.0" stylesheets="@Style.css" AnchorPane.leftAnchor="9.0" AnchorPane.rightAnchor="9.0" AnchorPane.topAnchor="9.0" />

        <Button fx:id="loadButton" layoutX="38.0" layoutY="44.0" mnemonicParsing="false" onAction="#loadPage" stylesheets="@Style.css" text="LOAD" AnchorPane.topAnchor="44.0" />
        <Button fx:id="backButton" layoutX="98.0" layoutY="44.0" mnemonicParsing="false" onAction="#back" stylesheets="@Style.css" text="←" AnchorPane.topAnchor="44.0" />
        <Button fx:id="forwardButton" layoutX="135.0" layoutY="44.0" mnemonicParsing="false" onAction="#forward" stylesheets="@Style.css" text="→" AnchorPane.topAnchor="44.0" />
        <Button fx:id="refreshButton" layoutX="170.0" layoutY="44.0" mnemonicParsing="false" onAction="#refreshPage" stylesheets="@Style.css" text="↺" AnchorPane.topAnchor="44.0" />
        <Button fx:id="zoomInButton" layoutX="207.0" layoutY="44.0" mnemonicParsing="false" onAction="#zoomIn" stylesheets="@Style.css" text="+" AnchorPane.topAnchor="44.0" />
        <Button fx:id="zoomOutButton" layoutX="239.0" layoutY="44.0" mnemonicParsing="false" onAction="#zoomOut" stylesheets="@Style.css" text="-" AnchorPane.topAnchor="44.0" />
        <Button fx:id="poshmarkButton" layoutX="269.0" layoutY="49.0" mnemonicParsing="false" onAction="#poshmark" stylesheets="@Style.css" text="POSHMARK" AnchorPane.topAnchor="44.0" />
        <Button fx:id="secondandcharlesButton" layoutX="369.0" layoutY="49.0" mnemonicParsing="false" onAction="#secondandCharles" stylesheets="@Style.css" text="2ND AND CHARLES" AnchorPane.topAnchor="44.0" />
        <Button fx:id="historyButton" layoutX="514.0" layoutY="49.0" mnemonicParsing="false" onAction="#displayHistory" stylesheets="@Style.css" text="HISTORY" AnchorPane.rightAnchor="9.0" AnchorPane.topAnchor="44.0" />
        <Button fx:id="newTabButton" layoutX="9.0" layoutY="44.0" mnemonicParsing="false" onAction="#newTab" stylesheets="@Style.css" text="+" AnchorPane.topAnchor="44.0" />

        <TabPane fx:id="myTabPane" stylesheets="@Style.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="83.0" />
    </children>
</AnchorPane>
